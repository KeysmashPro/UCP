DEBUGGER  := lldb
SRCS      := src/main.c
GLSLC     := glslc
BUILD_DIR ?= build

PODMAN 	  ?= podman
IMAGE ?= vulkan-ci-build:latest

UNAME_S := $(shell uname -s 2>/dev/null)

ifeq ($(PLATFORM),)
  ifneq (,$(findstring MINGW,$(UNAME_S)))
    PLATFORM := windows
  else ifneq (,$(findstring MSYS,$(UNAME_S)))
    PLATFORM := windows
  else
    PLATFORM := linux
  endif
endif
ifeq ($(PLATFORM),linux)
    CC       := cc
    TARGET   := $(BUILD_DIR)/ucp
    LDFLAGS_BASE  := -lglfw -lm
    NATIVE_TUNING := -march=native -mtune=native
	SANITIZERS    := -fsanitize=address,undefined -fno-omit-frame-pointer
    SANITIZERS_LD := -fsanitize=address,undefined
    ASAN_OPTIONS  := detect_leaks=1:halt_on_error=0
    UBSAN_OPTIONS := print_stacktrace=1:halt_on_error=0
    LSAN_OPTIONS  := suppressions=$(CURDIR)/lsan.supp:print_suppressions=0
else ifeq ($(PLATFORM),windows)
    CC       := clang
    TARGET   := $(BUILD_DIR)/ucp.exe
    LDFLAGS_BASE  := -lglfw3 -lgdi32 -luser32 -lshell32
    NATIVE_TUNING :=
    SANITIZERS    :=
    SANITIZERS_LD :=
else ifeq ($(PLATFORM),mingw)
    CC       := x86_64-w64-mingw32-gcc
    TARGET   := $(BUILD_DIR)/ucp.exe
    PLATFORM_INCLUDES := -I./lib/win64/glfw/include
    LDFLAGS_BASE  := -L./lib/win64/glfw -lglfw3 -lgdi32 -luser32 -lshell32
    NATIVE_TUNING :=
    SANITIZERS    :=
    SANITIZERS_LD :=
else
    $(error Unknown PLATFORM=$(PLATFORM). Use linux, windows or mingw)
endif

CFLAGS_COMMON := -pipe -Wall -Werror -I./src -I./lib -I./lib/vulkan-headers $(PLATFORM_INCLUDES)
CFLAGS_NATIVE  := $(CFLAGS_COMMON) -O2 $(NATIVE_TUNING) -flto -DNDEBUG
CFLAGS_V1		:= $(CFLAGS_COMMON) -O2 -flto -march=x86-64 -mtune=generic

CFLAGS_DEBUG  := $(CFLAGS_COMMON) -O0 -g3 -DDEBUG $(SANITIZERS)
LDFLAGS_DEBUG := $(LDFLAGS_BASE) $(SANITIZERS_LD)

CFLAGS := $(CFLAGS_NATIVE)
LDFLAGS := $(LDFLAGS_BASE)

YELLOW := \033[33m
GREEN  := \033[32m
RED    := \033[31m
RESET  := \033[0m

all: clean compile

windows:
	@$(MAKE) PLATFORM=mingw compile

run: clean compile
	@printf "$(GREEN)Running $(TARGET):$(RESET)\n"
	@./$(TARGET)

release: CFLAGS := $(CFLAGS_NATIVE)
release: LDFLAGS := $(LDFLAGS_BASE)
release: clean compile

debug: CFLAGS := $(CFLAGS_DEBUG)
debug: LDFLAGS := $(LDFLAGS_DEBUG)
debug: clean compile
	@printf "$(GREEN)Running in DEBUG mode with Sanitizers:$(RESET)\n"
	@ASAN_OPTIONS="$(ASAN_OPTIONS)" UBSAN_OPTIONS="$(UBSAN_OPTIONS)" LSAN_OPTIONS="$(LSAN_OPTIONS)" ./$(TARGET)

base: CFLAGS := $(CFLAGS_V1)
base: LDFLAGS := $(LDFLAGS_BASE)
base: clean compile

compile: $(TARGET)

$(TARGET): $(SRCS) src/shaders/shaderdump.h
	@mkdir -p $(BUILD_DIR)
	@printf "$(GREEN)Compiling $(TARGET) [$(PLATFORM)]:$(RESET)\n"
	$(CC) $(CFLAGS) -o $@ $(SRCS) $(LDFLAGS)

src/shaders/shaderdump.h: src/shaders/shader.vert src/shaders/shader.frag src/shaders/shader.comp
	@mkdir -p $(BUILD_DIR)
	@if ! command -v $(GLSLC) > /dev/null 2>&1; then \
		printf "$(RED)Error: glslc not found. Install the Vulkan SDK and shaderc $(RESET)\n"; \
		exit 1; \
	fi
	@printf "$(GREEN)Compiling shaders with $(GLSLC)...$(RESET)\n"
	@$(GLSLC) -fshader-stage=vertex   src/shaders/shader.vert -o $(BUILD_DIR)/vert.spv
	@$(GLSLC) -fshader-stage=fragment src/shaders/shader.frag -o $(BUILD_DIR)/frag.spv
	@$(GLSLC) -fshader-stage=compute  src/shaders/shader.comp -o $(BUILD_DIR)/comp.spv
	@echo "//  Shader hex-dump auto-generated by make" > $@
	@echo "" >> $@
	@echo "#ifndef SHADERDUMP_H" >> $@
	@echo "#define SHADERDUMP_H" >> $@
	@echo "#include <stdint.h>" >> $@
	@echo "#include <stddef.h>" >> $@
	@echo "static const uint32_t vert_spv[] = {" >> $@
	@od -v -An -tx4 $(BUILD_DIR)/vert.spv | awk '{ for (i=1; i<=NF; i++) printf "0x%s, ", $$i; print "" }' >> $@
	@echo "};" >> $@
	@echo "static const uint32_t frag_spv[] = {" >> $@
	@od -v -An -tx4 $(BUILD_DIR)/frag.spv | awk '{ for (i=1; i<=NF; i++) printf "0x%s, ", $$i; print "" }' >> $@
	@echo "};" >> $@
	@echo "static const uint32_t comp_spv[] = {" >> $@
	@od -v -An -tx4 $(BUILD_DIR)/comp.spv | awk '{ for (i=1; i<=NF; i++) printf "0x%s, ", $$i; print "" }' >> $@
	@echo "};" >> $@
	@echo "static const size_t vert_size = sizeof(vert_spv);" >> $@
	@echo "static const size_t frag_size = sizeof(frag_spv);" >> $@
	@echo "static const size_t comp_size = sizeof(comp_spv);" >> $@
	@echo "#endif" >> $@
	@rm -f $(BUILD_DIR)/vert.spv $(BUILD_DIR)/frag.spv $(BUILD_DIR)/comp.spv

clean:
	rm -rf $(BUILD_DIR)
	rm -f src/shaders/shaderdump.h

ci-build:
	export WOODPECKER_REPO_PATH=$(CURDIR); \
	woodpecker-cli exec --env LOCAL_UID=$$(id -u) --env LOCAL_GID=$$(id -g) .woodpecker/ci-build.yml

image:
	$(PODMAN) build -t $(IMAGE) -f Containerfile .

podman-release: image
	$(PODMAN) run --rm \
		-v $(CURDIR):/src:Z \
		-w /src \
		--userns=keep-id \
		$(IMAGE) \
		make release BUILD_DIR=build/

podman-windows: image
	$(PODMAN) run --rm \
		-v $(CURDIR):/src:Z \
		-w /src \
		--userns=keep-id \
		$(IMAGE) \
		make windows BUILD_DIR=build/windows

podman-all: podman-release podman-windows

.PHONY: all compile run release debug ci-build windows clean image podman-release podman-windows podman-all
.NOTPARALLEL:
